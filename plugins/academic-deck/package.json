{
  "name": "@godcreator/gwb-academic-deck",
  "version": "0.1.0",
  "description": "学术汇报的创建、构建、检查和 PDF 导出命令，以及供 agent 使用的制作说明",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "templates"
  ],
  "keywords": [
    "gwb-plugin"
  ],
  "publishConfig": {
    "registry": "https://git.tianshen02.online:28377/api/packages/godcreator/npm/"
  },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint . --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@godcreator/gwb-kernel-desktop": "^0.10.0",
    "@godcreator/gwb-skills": "^0.4.13",
    "@godcreator/gwb-commands": "^0.6.0"
  },
  "devDependencies": {
    "@godcreator/academic-deck": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.0",
    "playwright-core": "^1.63.0",
    "playwright": "^1.63.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "vitest": "^4.1.10"
  }
}
